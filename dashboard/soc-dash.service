[Unit]
Description=SOC-Guard Dashboard (FastAPI, localhost only)
After=network.target

[Service]
Type=simple
User=socdash
Group=socdash
Environment=SOC_DB_PATH=/opt/soc/data/soc.db
Environment=SOC_SITE_URL=https://bolnogledachi.bg
WorkingDirectory=/opt/soc-dash/app
ExecStart=/opt/soc-dash/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8899
Restart=always
RestartSec=5

# hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/soc/data

[Install]
WantedBy=multi-user.target
