# SOC-Guard configuration. Copy to /etc/soc-guard/soc-guard.env,
# fill in the values, and chmod 600 (it holds secrets).

# ---- Telegram alerting (required for push alerts) ----
# Create a bot via @BotFather, message it once, then get your chat id:
#   curl -s "https://api.telegram.org/bot<TOKEN>/getUpdates"
SOC_TG_TOKEN=123456:your-bot-token-here
SOC_TG_CHAT=your-numeric-chat-id

# ---- Target ----
SOC_SITE_URL=https://example.com
SOC_ACCESS_LOG=/var/log/nginx/access.log
SOC_SSH_UNIT=ssh                      # 'ssh' on Debian/Ubuntu, 'sshd' on RHEL/Alma
SOC_ALLOWED_SSH_USERS=youruser        # comma-separated allowlist of expected SSH users
SOC_DB_PATH=/var/lib/soc-guard/soc.db

# ---- External heartbeat (optional but recommended) ----
# A healthchecks.io (or similar) ping URL. heartbeat.sh pings it every few min.
SOC_HEARTBEAT_URL=https://hc-ping.com/your-uuid-here
SOC_SERVICE_NAME=soc-guard

# ---- Detection thresholds (optional - defaults shown) ----
SOC_BRUTE_WINDOW=300
SOC_BRUTE_LIMIT=10
SOC_SCAN_WINDOW=60
SOC_SCAN_404_LIMIT=15
SOC_5XX_WINDOW=300
SOC_5XX_LIMIT=5
SOC_HEALTH_INTERVAL=60
SOC_HEALTH_FAILS=3
SOC_ALERT_COOLDOWN=600

# ---- File Integrity Monitoring (optional; hash-based, no git required) ----
# Watches a set of files/globs for content change, deletion, or new files.
# Baseline (sha256 per file) is stored in the SQLite DB and survives restarts.
# After a legitimate deploy, reset it:  python3 soc_guard.py --rebaseline
SOC_FIM_ENABLED=0
# comma-separated files and/or shell globs (glob, not blind recursion):
#   /etc/nginx/nginx.conf, /etc/ssh/sshd_config, /var/www/html/*.php
SOC_FIM_PATHS=
SOC_FIM_INTERVAL=300

# ---- GeoIP enrichment (optional; MaxMind GeoLite2) ----
# Appends "City, CC · ASxxx Org" to every IP-bearing alert. Needs the free
# GeoLite2 City + ASN .mmdb files (see docs/INSTALL.md for geoipupdate setup).
SOC_GEOIP_ENABLED=0
SOC_GEOIP_CITY_DB=/var/lib/GeoIP/GeoLite2-City.mmdb
SOC_GEOIP_ASN_DB=/var/lib/GeoIP/GeoLite2-ASN.mmdb
